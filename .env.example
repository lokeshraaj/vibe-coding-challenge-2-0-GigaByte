# ==============================================================================
# ATHLIX Multi-Tenant SaaS Environment Configuration
# ==============================================================================

# Database: MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/athlix?retryWrites=true&w=majority

# Authentication: Auth.js (NextAuth v5) Configuration
# Generate a secret with: `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=athlix_super_secure_production_ready_secret_key_2026_xyz987654321
AUTH_URL=http://localhost:3000

# Google OAuth Credentials (Google Cloud Console > Credentials > OAuth 2.0 Client IDs)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Legacy Session Support Secret (Optional fallback)
JWT_SECRET=athlix_super_secure_production_ready_jwt_secret_key_2026_xyz987654321

# Public Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Initial Platform Super Admin (Provisioned automatically on first Google or credential login)
INITIAL_SUPER_ADMIN_EMAIL=superadmin@athlix.com
INITIAL_SUPER_ADMIN_PASSWORD=AthlixAdmin2026!
